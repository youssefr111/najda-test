# ── Backend (Spring Boot) ────────────────────────────────────────────────
# Base URL of the NAJDA backend REST API, no trailing slash.
# Use your machine's LAN IP (not "localhost") when testing on a physical
# device or in Expo Go, e.g. http://192.168.1.20:8080
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

# Base URL for the STOMP-over-WebSocket endpoint exposed by the backend.
EXPO_PUBLIC_WS_URL=ws://localhost:8080/ws

# URL of the deployed NAJDA web app. Passwordless registration sends the
# sign-in link here (mobile has no Firebase Dynamic Links replacement, so
# new citizens finish signing up in a browser, then log in with a password
# in the app afterwards — see src/screens/RegisterScreen.tsx).
EXPO_PUBLIC_WEB_APP_URL=https://najda.example.com

# ── Firebase (identity only — same project as the web app) ─────────────
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# ── Google Sign-In (OAuth client IDs from Google Cloud Console) ────────
# Create these under the SAME Google Cloud project as your Firebase project.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=