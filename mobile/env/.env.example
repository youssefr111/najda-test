# ── Backend (Spring Boot) ────────────────────────────────────────────────
# Use your machine's LAN IP (not "localhost") when testing on a physical
API_BASE_URL=http://192.168.1.10:8080

# Base URL for the STOMP-over-WebSocket endpoint exposed by the backend.
WS_URL=ws://192.168.1.10:8080/ws

# URL of the deployed web app.
WEB_APP_URL=

# ── Firebase ─────────────
FIREBASE_API_KEY=
FIREBASE_ANDROID_API_KEY=
FIREBASE_IOS_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# ── Google Sign-In (OAuth client IDs from Google Cloud Console) ────────
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=

# ── EmailJS ───────────────
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=