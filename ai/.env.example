# Only needed when you run this service OUTSIDE docker compose (e.g. `uvicorn --env-file .env ...`).
# Under compose the value comes from the root .env.
# Shared secret: must be IDENTICAL to AI_API_KEY in the backend. Generate: openssl rand -hex 32
AI_API_KEY=change-me
# MODELS_DIR=models
# ALLOW_VERSION_MISMATCH=0   # 1 = skip the library-version check (not recommended)
