# Backend secrets and settings. Copy to backend/.env (git-ignored).
# docker compose reads this file; the database host and the Firebase key path are overridden there for Docker.
# Running outside Docker (./mvnw spring-boot:run), the `dev` profile uses localhost:5432 (postgres/postgres).

# ── Firebase ──────────────────────────────────────────────
# Path to your downloaded Firebase service account JSON key.
# Get this from: Firebase Console -> Project Settings -> Service Accounts -> Generate new private key.
# The same key verifies logins AND sends push notifications (FCM is free on the Spark plan).
# Outside Docker: a path on your machine. Inside Docker the compose file mounts it at /secrets/... for you.
FIREBASE_SERVICE_ACCOUNT_PATH=../secrets/private-key.json

# ── Email verification (registration OTP) ─────────────────
# HMAC key for hashing one-time codes (min 32 chars). Generate: openssl rand -base64 48
OTP_HMAC_SECRET=your_hmac_secret_here
# API key for Brevo for sending verification emails.
BREVO_API_KEY=your_brevo_api_key
# Must be a sender you have verified in Brevo.
MAIL_FROM_EMAIL=you@gmail.com

# ── Incident Location Rules (optional) ───────────────────────────────────────
INCIDENT_ALLOW_MANUAL_PIN=true
INCIDENT_MANUAL_PIN_MAX_RADIUS_METERS=300

# ── Push notifications (optional) ────────────────────────────────────────
PUSH_ENABLED=true

# ── Web Base URL ──────────────────────────────────────────────
WEB_BASE_URL=your-web-base-url

# ── App update check (optional) ───────────────────────────
# GitHub repository whose latest release is the current mobile app version (owner/name).
APP_RELEASE_REPOSITORY=youssefry01/najda

# ── Identity verification (Didit) ─────────────────────────
# false: nobody is blocked (everyone can still verify and see their badge). true: a person who is not verified cannot
# file an emergency report. Turn it on only after testing in Didit's sandbox.
KYC_REQUIRED=false
# Optional ISO instant, e.g. 2026-12-01T00:00:00Z: accounts created BEFORE it are never blocked (only invited to verify).
KYC_GRANDFATHER_BEFORE=
# Roles that are never blocked, so they can test the system.
KYC_EXEMPT_ROLES=ADMIN,SUPER_ADMIN
# From the Didit Business Console. The API key IS the environment: use the Sandbox application's key while testing.
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
# The webhook destination's secret (destination URL: https://<your-backend>/api/kyc/webhook, event: status.updated).
DIDIT_WEBHOOK_SECRET=
# "sandbox" or "live": must match the application the key belongs to. A webhook from the other one is ignored.
DIDIT_ENVIRONMENT=live
# Tag for THIS deployment when several share one Didit application: local- / test- / prod- (each must differ).
DIDIT_VENDOR_PREFIX=prod-

# ── Supabase ──────────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=your-bucket-name

# 256-bit AES key, base64-encoded. Generate once with: openssl rand -base64 32
TEXT_ENCRYPTION_KEY=

# ── OpenRouter ──────────────────────────────────────────────
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=your_openrouter_model

# One-time bootstrap: the Firebase UID of an account you created manually
# (Firebase console -> Authentication -> Add user) for the very first
# SUPER_ADMIN. Leave blank after the first successful startup -- the
# initializer no-ops once this UID already has a User row, but there's no
# harm in leaving the value in place either.
SUPER_ADMIN_FIREBASE_UID=your-super-admin-firebase-uid
SUPER_ADMIN_EMAIL=email@gmail.com

# ── Seed data ─────────────────────────────────────────────
# Load content/facilities.csv at startup (idempotent: rows already stored are skipped). Set to false to skip it.
FACILITY_SEED_ENABLED=true