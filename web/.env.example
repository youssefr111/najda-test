# Web app settings. Copy to web/.env (git-ignored).
#
# Two kinds of variable:
#   * Server-side secrets (no NEXT_PUBLIC_ prefix): read at RUNTIME by the Next.js server. They live here.
#   * NEXT_PUBLIC_* values: public, compiled into the browser bundle at BUILD time.
#     Running with Docker, set them in the repository's root .env (docker-compose passes them as build args);
#     running `npm run dev` / `npm run build` yourself, this file is where they are read from.

# --- Firebase Admin SDK (server-only — from a service account JSON) ---
FIREBASE_CLIENT_EMAIL=
# Keep the surrounding quotes; \n stays literal in .env and is restored in code.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Firebase client SDK (public — shipped to the browser) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Browser push (public) ---
# Firebase console -> Project settings -> Cloud Messaging -> Web Push certificates -> Generate key pair.
# Leave empty to keep browser push off (everything else works). Push needs HTTPS (localhost is fine).
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# --- EmailJS (public — shipped to the browser) ---
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your-service-id
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your-template-id
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your-public-key

# --- WebSocket URL (the browser connects to it directly) ---
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws

# --- Your Spring Boot API base URL (the browser calls it directly) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# --- App downloads / releases (public — shipped to the browser) ---
NEXT_PUBLIC_ANDROID_DOWNLOAD_URL=
NEXT_PUBLIC_IOS_DOWNLOAD_URL=
NEXT_PUBLIC_RELEASES_URL=