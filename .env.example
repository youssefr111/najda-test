# Read by `docker compose` itself (copy to ./.env at the repository root).
# Secrets for the backend and the web server live in backend/.env and web/.env.

# ── Postgres ─────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# ── Backend container ────────────────────────────────────
# Host path of the Firebase service-account JSON (mounted read-only into the container).
FIREBASE_SERVICE_ACCOUNT_HOST_PATH=./secrets/firebase-service-account.json
# Where a web-push notification sends the user when clicked (https in production).
WEB_BASE_URL=http://localhost:3000
# JVM flags. 75% of the container's memory is a sensible default; lower it on a small host.
BACKEND_JAVA_OPTS=-XX:MaxRAMPercentage=75
AI_API_KEY=

# ── Web app: PUBLIC values, compiled into the browser bundle at build time ──
# Change one and rebuild: docker compose up --build web
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Firebase console -> Project settings -> Cloud Messaging -> Web Push certificates -> Generate key pair.
# Empty = browser push stays off; everything else works.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
# The browser (not the container) calls these, so they are addresses as seen from the user's machine.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws
NEXT_PUBLIC_ANDROID_DOWNLOAD_URL=
NEXT_PUBLIC_IOS_DOWNLOAD_URL=
NEXT_PUBLIC_RELEASES_URL=
